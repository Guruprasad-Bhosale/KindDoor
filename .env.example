# KindDoor Environment Variables (Example Template)
# Copy this file to .env and populate with your credentials if available.

# Node & Server Settings
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Web Application Settings
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4000/mcp

# Database (PostgreSQL / SQLite via Prisma)
# For local SQLite development (default):
DATABASE_URL="file:./dev.db"
# For Docker PostgreSQL:
# DATABASE_URL="postgresql://kinddoor:kinddoor_dev_secret@localhost:5432/kinddoor_db?schema=public"

# Ring Integration (Optional - Simulator is enabled by default)
RING_API_KEY=""
RING_WEBHOOK_SECRET="kinddoor_dev_webhook_signing_secret_2026"
RING_USE_SIMULATOR=true

# Amazon Bedrock AWS Credentials (Optional - Deterministic fallback runs if omitted)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# Google Gemini API Credentials (Optional - Deterministic fallback runs if omitted)
# Official SDK: @google/genai
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"

# Access Policy & Cryptographic Token Secret
ACCESS_TOKEN_SECRET="kinddoor_secure_lock_token_hmac_secret_2026"
